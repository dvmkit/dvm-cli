engine-strict=true
fund=false
audit=false
ignore-scripts=true
legacy-peer-deps=true

# The published SDK is on the public npm registry. A workstation ~/.npmrc that maps
# @dvmkit to GitHub Packages would otherwise hijack every install of it, so pin the
# scope here where the repository — not the machine — decides.
@dvmkit:registry=https://registry.npmjs.org/
